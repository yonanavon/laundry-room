<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>הדמיית תלת-ממד - חדר כביסה 214x274 ס"מ</title>
  <style>
    body { margin: 0; overflow: hidden; font-family: system-ui, -apple-system, sans-serif; background: #1e293b; color: #fff; }
    #ui {
      position: absolute; top: 16px; right: 16px; left: 16px;
      display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center;
      background: rgba(15, 23, 42, 0.88); padding: 14px 20px; border-radius: 12px;
      backdrop-filter: blur(8px); box-shadow: 0 4px 20px rgba(0,0,0,0.4); z-index: 10;
    }
    .btn-group { display: flex; flex-wrap: wrap; gap: 8px; }
    button {
      background: #334155; color: #f8fafc; border: 1px solid #475569;
      padding: 9px 14px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600;
      transition: all 0.2s;
    }
    button:hover { background: #475569; }
    button.active { background: #2563eb; border-color: #60a5fa; box-shadow: 0 0 12px rgba(37,99,235,0.5); }
    #legend {
      position: absolute; bottom: 16px; right: 16px;
      background: rgba(15, 23, 42, 0.88); padding: 14px 18px; border-radius: 12px;
      font-size: 13px; line-height: 1.7; z-index: 10; box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .legend-item { display: flex; align-items: center; gap: 8px; }
    .swatch { width: 14px; height: 14px; border-radius: 3px; display: inline-block; border: 1px solid rgba(255,255,255,0.3); }
    #info-box {
      position: absolute; bottom: 16px; left: 16px; max-width: 340px;
      background: rgba(15, 23, 42, 0.88); padding: 14px 18px; border-radius: 12px;
      font-size: 13.5px; line-height: 1.5; z-index: 10; box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .label-3d {
      position: absolute; pointer-events: none; background: rgba(0,0,0,0.75);
      color: #fff; padding: 3px 7px; border-radius: 4px; font-size: 11.5px;
      white-space: nowrap; transform: translate(-50%, -50%); border: 1px solid rgba(255,255,255,0.2);
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>

<div id="ui">
  <div>
    <strong style="font-size:16px;">הדמיית חדר כביסה (214×274 ס"מ)</strong>
    <span style="font-size:12px; color:#94a3b8; margin-right:10px;">סובב עם העכבר | גלגלת לזום</span>
  </div>
  <div class="btn-group">
    <button id="btn-1" class="active" onclick="setLayout(1)">אופציה 1: תצורת "ח" (מכונות למעלה)</button>
    <button id="btn-2" onclick="setLayout(2)">אופציה 2: מכונות בשמאל + קיר ארונות</button>
    <button id="btn-3" onclick="setLayout(3)">אופציה 3: שני קירות מקבילים</button>
    <button id="btn-4" onclick="setLayout(4)">אופציה 4: מגדל + משטח מתקפל</button>
  </div>
</div>

<div id="legend">
  <strong>מקרא צבעים:</strong>
  <div class="legend-item"><span class="swatch" style="background:#3b82f6"></span> מכונת כביסה ומייבש (62×65)</div>
  <div class="legend-item"><span class="swatch" style="background:#06b6d4"></span> מקפיא קטן (רוחב 60)</div>
  <div class="legend-item"><span class="swatch" style="background:#f59e0b"></span> 3 סלי כביסה נשלפים (34×45 כ"א)</div>
  <div class="legend-item"><span class="swatch" style="background:#d97706"></span> משטח עץ לקיפול כביסה</div>
  <div class="legend-item"><span class="swatch" style="background:#e2e8f0"></span> ארונות אחסון נגישים</div>
  <div class="legend-item"><span class="swatch" style="background:#94a3b8"></span> אחסון פינתי עמוק (פחות נגיש)</div>
</div>

<div id="info-box"></div>
<div id="labels-container"></div>

<script>
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x1e293b);

  const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 2000);
  camera.position.set(0, 390, 380);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.shadowMap.enabled = true;
  document.body.appendChild(renderer.domElement);

  const controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.target.set(0, 60, 0);
  controls.update();

  // תאורה
  scene.add(new THREE.AmbientLight(0xffffff, 0.65));
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
  dirLight.position.set(150, 400, 250);
  dirLight.castShadow = true;
  scene.add(dirLight);

  // מידות החדר בס"מ
  const W = 214, D = 274, H = 260;

  // בניית רצפה וקירות שקופים למחצה
  const roomGroup = new THREE.Group();
  scene.add(roomGroup);

  // רצפת פרקט
  const floorGeo = new THREE.PlaneGeometry(W, D);
  const floorMat = new THREE.MeshStandardMaterial({ color: 0xc8a97e, roughness: 0.7 });
  const floor = new THREE.Mesh(floorGeo, floorMat);
  floor.rotation.x = -Math.PI / 2;
  floor.receiveShadow = true;
  roomGroup.add(floor);

  // רשת קנה מידה (כל משבצת כ-20 ס"מ)
  const grid = new THREE.GridHelper(300, 15, 0x475569, 0x334155);
  grid.position.y = 0.2;
  roomGroup.add(grid);

  const wallMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, transparent: true, opacity: 0.18, side: THREE.DoubleSide });
  const wallEdgeMat = new THREE.LineBasicMaterial({ color: 0x64748b });

  function addWall(w, h, x, y, z, rotY = 0) {
    const geo = new THREE.PlaneGeometry(w, h);
    const mesh = new THREE.Mesh(geo, wallMat);
    mesh.position.set(x, y, z);
    mesh.rotation.y = rotY;
    roomGroup.add(mesh);
    const edges = new THREE.LineSegments(new THREE.EdgesGeometry(geo), wallEdgeMat);
    edges.position.copy(mesh.position);
    edges.rotation.copy(mesh.rotation);
    roomGroup.add(edges);
  }

  // קיר עליון (214), קיר שמאלי - מטבח (274), קיר ימני - חדר שינה (274)
  addWall(W, H, 0, H/2, -D/2, 0);
  addWall(D, H, -W/2, H/2, 0, Math.PI/2);
  addWall(D, H, W/2, H/2, 0, Math.PI/2);

  // דלת כניסה בקיר התחתון בצד שמאל (נפתחת החוצה)
  const doorGeo = new THREE.BoxGeometry(82, 205, 4);
  const doorMat = new THREE.MeshStandardMaterial({ color: 0xfef08a, transparent: true, opacity: 0.55 });
  const door = new THREE.Mesh(doorGeo, doorMat);
  // ציר הדלת בפינה השמאלית-תחתונה, פתוחה החוצה ב-65 מעלות
  door.position.set(-W/2 + 20, 102.5, D/2 + 35);
  door.rotation.y = Math.PI / 2.8;
  roomGroup.add(door);

  const layoutGroup = new THREE.Group();
  scene.add(layoutGroup);
  let labels = [];

  function clearLayout() {
    while(layoutGroup.children.length > 0) {
      layoutGroup.remove(layoutGroup.children[0]);
    }
    labels.forEach(l => l.el.remove());
    labels = [];
  }

  // פונקציית עזר להצבת קובייה לפי פינה שמאלית-עליונה של השרטוט (x: 0..214, z: 0..274, y: 0..260)
  function addItem(x, y, z, w, h, d, color, labelText = "", opacity = 1.0) {
    const geo = new THREE.BoxGeometry(w, h, d);
    const mat = new THREE.MeshStandardMaterial({
      color: color,
      roughness: 0.4,
      transparent: opacity < 1.0,
      opacity: opacity
    });
    const mesh = new THREE.Mesh(geo, mat);
    const posX = -W/2 + x + w/2;
    const posY = y + h/2;
    const posZ = -D/2 + z + d/2;
    mesh.position.set(posX, posY, posZ);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    layoutGroup.add(mesh);

    const edges = new THREE.LineSegments(
      new THREE.EdgesGeometry(geo),
      new THREE.LineBasicMaterial({ color: 0x1e293b, linewidth: 1 })
    );
    edges.position.copy(mesh.position);
    layoutGroup.add(edges);

    if (labelText) {
      const el = document.createElement('div');
      el.className = 'label-3d';
      el.innerText = labelText;
      document.getElementById('labels-container').appendChild(el);
      labels.push({ el, pos: new THREE.Vector3(posX, y + h + 6, posZ) });
    }
  }

  // צבעים
  const C_WASH = 0x3b82f6;    // כחול - מכונה/מייבש
  const C_FREEZE = 0x06b6d4;  // טורקיז - מקפיא
  const C_HAMPER = 0xf59e0b;  // כתום - סלי כביסה
  const C_WOOD = 0xd97706;    // עץ - משטח קיפול
  const C_CAB = 0xf1f5f9;     // לבן/אפור בהיר - ארונות
  const C_DEEP = 0x94a3b8;    // אפור כהה - אחסון פינתי פחות נגיש

  const descriptions = {
    1: "<strong>אופציה 1 (תצורת 'ח'):</strong> מכונה ומייבש זו לצד זו בקיר העליון תחת משטח קיפול רציף של 214 ס\"מ. בימין: 3 סלי כביסה בשורה, מקפיא 60 וארון שירות. בשמאל: ארון רדוד (35 ס\"מ) שמשאיר כניסה מרווחת ומרכז חדר רחב (119 ס\"מ).",
    2: "<strong>אופציה 2 (מכונות בשמאל + קיר ארונות בימין):</strong> המכונות צמודות לקיר המטבח (שמאל) ומשטח הקיפול ממשיך בצורת 'ר' מעל 3 סלי הכביסה. כל הקיר הימני (274 ס\"מ) הוא קיר ארונות עמוק + מקפיא שחוצץ אקוסטית מחדר השינה.",
    3: "<strong>אופציה 3 (שני קירות מקבילים):</strong> בקיר הימני משטח קיפול ישר של 234 ס\"מ ומתחתיו מכונה, מייבש ו-3 סלי כביסה בשורה אחת + ארון שירות. בקיר השמאלי מקפיא וארון אחסון עמוק ללא שום פינה מתה.",
    4: "<strong>אופציה 4 (מגדל + משטח מתקפל):</strong> מכונה ומייבש במגדל בפינה השמאלית-עליונה. לצידם משטח קיפול מתקפל לקיר (130 ס\"מ). שאר החדר (קיר עליון + קיר ימני מלא) מוקדש לארונות אחסון מרצפה עד תקרה. מקסימום נפח אחסון!"
  };

  function setLayout(num) {
    clearLayout();
    document.querySelectorAll('.btn-group button').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-' + num).classList.add('active');
    document.getElementById('info-box').innerHTML = descriptions[num];

    // תוויות קירות קבועות
    addItem(0, 0, -2, 2, 2, 2, 0x1e293b, "קיר עליון (214 ס\"מ)", 0);
    addItem(-2, 0, 137, 2, 2, 2, 0x1e293b, "קיר שמאל - גובל במטבח (274 ס\"מ)", 0);
    addItem(214, 0, 137, 2, 2, 2, 0x1e293b, "קיר ימין - גובל בחדר שינה (274 ס\"מ)", 0);
    addItem(45, 0, 274, 2, 2, 2, 0x1e293b, "דלת כניסה (נפתחת החוצה)", 0);

    if (num === 1) {
      // קיר עליון
      addItem(0, 0, 0, 62, 85, 65, C_WASH, "מכונת כביסה (62)");
      addItem(62, 0, 0, 62, 85, 65, C_WASH, "מייבש כביסה (62)");
      addItem(124, 0, 0, 90, 85, 65, C_DEEP, "אחסון פינתי עמוק (90)");
      addItem(0, 85, 0, 214, 5, 65, C_WOOD, "משטח קיפול רציף (214×65)");
      addItem(0, 150, 0, 214, 110, 40, C_CAB, "ארונות עליונים (214)", 0.85);

      // קיר ימני
      addItem(154, 0, 65, 60, 85, 110, C_HAMPER, "3 סלי כביסה נשלפים (110)");
      addItem(154, 85, 65, 60, 175, 110, C_CAB, "ארון אחסון (110)", 0.85);
      addItem(154, 0, 175, 60, 140, 60, C_FREEZE, "מקפיא (60)");
      addItem(154, 140, 175, 60, 120, 60, C_CAB, "ארון מעל מקפיא", 0.85);
      addItem(154, 0, 235, 60, 260, 39, C_CAB, "ארון שירות (39)", 0.9);

      // קיר שמאלי
      addItem(0, 0, 65, 35, 260, 120, C_CAB, "ארון אחסון רדוד (עומק 35, אורך 120)", 0.85);
    }

    else if (num === 2) {
      // קיר שמאלי
      addItem(0, 0, 0, 65, 85, 60, C_DEEP, "אחסון פינתי (60)");
      addItem(0, 0, 60, 65, 85, 62, C_WASH, "מכונת כביסה (62)");
      addItem(0, 0, 122, 65, 85, 62, C_WASH, "מייבש כביסה (62)");
      addItem(0, 85, 0, 65, 5, 184, C_WOOD, "משטח קיפול (184×65)");
      addItem(0, 150, 0, 40, 110, 184, C_CAB, "ארונות עליונים (184)", 0.85);

      // קיר עליון (מרכז)
      addItem(65, 0, 0, 89, 85, 50, C_HAMPER, "3 סלי כביסה (89)");
      addItem(65, 85, 0, 89, 5, 50, C_WOOD, "המשך משטח 'ר'");
      addItem(65, 150, 0, 89, 110, 40, C_CAB, "ארון עליון", 0.85);

      // קיר ימני (קיר ארונות מלא)
      addItem(154, 0, 0, 60, 260, 60, C_DEEP, "ארון פינה עמוק (60×60)", 0.9);
      addItem(154, 0, 60, 60, 260, 154, C_CAB, "ארון אחסון ענק מרצפה עד תקרה (154)", 0.88);
      addItem(154, 0, 214, 60, 140, 60, C_FREEZE, "מקפיא (60)");
      addItem(154, 140, 214, 60, 120, 60, C_CAB, "ארון מעל מקפיא", 0.85);
    }

    else if (num === 3) {
      // קיר ימני - שורה ישרה
      addItem(149, 0, 0, 65, 85, 62, C_WASH, "מכונת כביסה (62)");
      addItem(149, 0, 62, 65, 85, 62, C_WASH, "מייבש כביסה (62)");
      addItem(149, 0, 124, 65, 85, 110, C_HAMPER, "3 סלי כביסה בשורה (110)");
      addItem(149, 85, 0, 65, 5, 234, C_WOOD, "משטח קיפול ישר (234×65)");
      addItem(174, 150, 0, 40, 110, 234, C_CAB, "ארונות עליונים (234)", 0.85);
      addItem(149, 0, 234, 65, 260, 40, C_CAB, "ארון שירות (40)", 0.9);

      // קיר שמאלי
      addItem(0, 0, 0, 60, 260, 124, C_CAB, "ארון אחסון עמוק מלא (124×60)", 0.88);
      addItem(0, 0, 124, 60, 140, 60, C_FREEZE, "מקפיא (60)");
      addItem(0, 140, 124, 60, 120, 60, C_CAB, "ארון מעל מקפיא", 0.85);
    }

    else if (num === 4) {
      // מגדל כביסה בפינה שמאלית-עליונה
      addItem(0, 0, 0, 65, 85, 65, C_WASH, "מכונת כביסה (תחתונה)");
      addItem(0, 85, 0, 65, 5, 65, C_WOOD, "");
      addItem(0, 90, 0, 65, 85, 65, C_WASH, "מייבש כביסה (עליון)");
      addItem(0, 175, 0, 65, 85, 65, C_CAB, "ארון מעל המגדל", 0.85);

      // משטח מתקפל בקיר השמאלי
      addItem(0, 85, 65, 55, 4, 130, C_WOOD, "משטח קיפול מתקפל (130×55)");
      addItem(0, 150, 65, 35, 110, 130, C_CAB, "ארון עליון רדוד (130)", 0.85);

      // קיר עליון
      addItem(65, 0, 0, 89, 85, 55, C_HAMPER, "3 סלי כביסה (89)");
      addItem(65, 85, 0, 89, 175, 55, C_CAB, "ארון אחסון (89)", 0.88);

      // קיר ימני מלא
      addItem(154, 0, 0, 60, 260, 60, C_DEEP, "פינה עמוקה (60×60)", 0.9);
      addItem(154, 0, 60, 60, 260, 154, C_CAB, "קיר ארונות אחסון עצום (154×60)", 0.88);
      addItem(154, 0, 214, 60, 140, 60, C_FREEZE, "מקפיא (60)");
      addItem(154, 140, 214, 60, 120, 60, C_CAB, "ארון מעל מקפיא", 0.85);
    }
  }

  function updateLabels() {
    labels.forEach(item => {
      const v = item.pos.clone();
      v.project(camera);
      const x = (v.x * 0.5 + 0.5) * window.innerWidth;
      const y = (-(v.y * 0.5) + 0.5) * window.innerHeight;
      if (v.z < 1) {
        item.el.style.display = 'block';
        item.el.style.left = `${x}px`;
        item.el.style.top = `${y}px`;
      } else {
        item.el.style.display = 'none';
      }
    });
  }

  function animate() {
    requestAnimationFrame(animate);
    controls.update();
    updateLabels();
    renderer.render(scene, camera);
  }

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  setLayout(1);
  animate();
</script>
</body>
</html>
